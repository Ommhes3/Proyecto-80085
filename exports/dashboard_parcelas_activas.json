                      "spec": {
                        "query": "from(bucket: \"sensor_data\")\r\n  |> range(start: -1d)\r\n  |> filter(fn: (r) => r._measurement == \"sensor_readings\")\r\n  |> filter(fn: (r) => r._field == \"value\")\r\n  |> filter(fn: (r) => exists r.parcel)\r\n  |> filter(fn: (r) => exists r.crop)\r\n  |> group(columns: [\"parcel\", \"crop\"])\r\n  |> last()\r\n  |> group()\r\n  |> map(fn: (r) => ({\r\n      Parcela: r.parcel,\r\n      Cultivo: r.crop,\r\n      Ver_arroz: if r.crop == \"rice\" then \"Abrir\" else \"\",\r\n      Ver_cana: if r.crop == \"sugar_cane\" then \"Abrir\" else \"\"\r\n  }))\r\n  |> keep(columns: [\"Parcela\", \"Cultivo\", \"Ver_arroz\", \"Ver_cana\"])\r\n  |> sort(columns: [\"Parcela\"])"
