      "panel-8": {
        "kind": "Panel",
        "spec": {
          "id": 8,
          "title": "Historial alertas en el tiempo",
          "description": "",
          "links": [],
          "data": {
            "kind": "QueryGroup",
            "spec": {
              "queries": [
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "query": {
                      "kind": "DataQuery",
                      "group": "influxdb",
                      "version": "v0",
                      "spec": {
                        "query": "from(bucket: \"sensor_data\")\r\n  |> range(start: -20m)\r\n  |> filter(fn: (r) => r._measurement == \"sensor_readings\")\r\n  |> filter(fn: (r) => r._field == \"value\")\r\n  |> filter(fn: (r) => r.parcel == \"${parcel}\")\r\n  |> aggregateWindow(every: 1m, fn: last, createEmpty: false)\r\n  |> map(fn: (r) => ({\r\n      r with\r\n      _value: if r.alert_level == \"critical\" then 1 else 0,\r\n      _field: r.sensor\r\n  }))\r\n  |> keep(columns: [\"_time\", \"_value\", \"_field\"])\r\n  |> group(columns: [\"_field\"])\r\n  |> yield(name: \"estado_alerta\")"
                      },
                      "labels": {
                        "grafana.app/export-label": "influxdb-1"
                      }
                    },
                    "refId": "A",
                    "hidden": false
                  }
                }
              ],
              "transformations": [],
              "queryOptions": {}
            }
          },
          "vizConfig": {
            "kind": "VizConfig",
            "group": "status-history",
            "version": "13.0.1+security-01",
            "spec": {
              "options": {
                "annotations": {
                  "clustering": -1,
                  "multiLane": false
                },
                "colWidth": 0.9,
                "legend": {
                  "displayMode": "list",
                  "placement": "bottom",
                  "showLegend": true
                },
                "rowHeight": 0.9,
                "showValue": "never",
                "tooltip": {
                  "hideZeros": false,
                  "mode": "single",
                  "sort": "none"
                }
              },
              "fieldConfig": {
                "defaults": {
                  "mappings": [
                    {
                      "type": "value",
                      "options": {
                        "0": {
                          "text": "Normal",
                          "color": "dark-green",
                          "index": 1
                        },
                        "1": {
                          "text": "Critical",
                          "color": "dark-red",
                          "index": 0
                        }
                      }
                    }
                  ],
                  "thresholds": {
                    "mode": "absolute",
                    "steps": [
                      {
                        "value": 0,
                        "color": "green"
                      }
                    ]
                  },
                  "color": {
                    "mode": "thresholds"
                  },
                  "custom": {
                    "axisPlacement": "auto",
                    "fillOpacity": 70,
                    "hideFrom": {
                      "legend": false,
                      "tooltip": false,
                      "viz": false
                    },
                    "lineWidth": 1
                  }
                },
                "overrides": []
              }
            }
          }
        }
