      "panel-6": {
        "kind": "Panel",
        "spec": {
          "id": 6,
          "title": "Historial de alertas",
          "description": "",
          "links": [],
          "data": {
            "kind": "QueryGroup",
            "spec": {
              "queries": [
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "query": {
                      "kind": "DataQuery",
                      "group": "influxdb",
                      "version": "v0",
                      "spec": {
                        "query": "from(bucket: \"sensor_data\")\r\n  |> range(start: today())\r\n  |> filter(fn: (r) => r._measurement == \"sensor_readings\")\r\n  |> filter(fn: (r) => r._field == \"alert\")\r\n  |> filter(fn: (r) => r._value == 1)\r\n  |> filter(fn: (r) => r.parcel == \"${parcel}\")\r\n  |> filter(fn: (r) => r.crop == \"sugar_cane\")\r\n  |> map(fn: (r) => ({\r\n      Hora: r._time,\r\n      Sensor: r.sensor,\r\n      Cultivo: r.crop,\r\n      Mensaje: r.alert_description\r\n  }))\r\n  |> group()\r\n  |> sort(columns: [\"Hora\"], desc: true)"
                      },
                      "labels": {
                        "grafana.app/export-label": "influxdb-1"
                      }
                    },
                    "refId": "A",
                    "hidden": false
                  }
                }
              ],
